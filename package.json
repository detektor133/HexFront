{
  "name": "hexfront",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "depcheck": "depcruise packages apps tools --config .dependency-cruiser.cjs",
    "test": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm depcheck && pnpm tokens --check && pnpm test",
    "format": "prettier --write .",
    "ai-check": "node --experimental-strip-types tools/ai-check/src/cli.ts",
    "verify": "node --experimental-strip-types tools/ai-check/src/verify.ts",
    "visual": "node --disable-warning=DEP0190 --experimental-strip-types apps/client/tests/visual/visual-check.ts",
    "report:match": "node --experimental-strip-types tools/replay/src/report-match.ts",
    "evolve": "node --experimental-strip-types tools/evolve/src/index.ts",
    "telemetry:report": "node --experimental-strip-types tools/telemetry/src/cli.ts",
    "commit-check": "node --experimental-strip-types tools/commit-check/src/cli.ts",
    "ci:wait": "node --experimental-strip-types tools/ci-wait/src/cli.ts",
    "agent:run": "node --experimental-strip-types tools/agent-loop/src/cli.ts",
    "tokens": "node --experimental-strip-types tools/tokens/src/cli.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
